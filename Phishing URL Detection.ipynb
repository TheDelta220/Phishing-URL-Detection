    "# https://pandas.pydata.org/docs/reference/index.html\n",
    "import pandas as pd\n",
    "\n",
    "#loads the CSV file and stores it as \"df\" or Data Frame\n",
    "df0 = pd.read_csv(\"dataset/malicious_phish.csv\")\n",
    "df1 = pd.read_csv(\"dataset/balanced_urls.csv\")\n",
    "df2 = pd.read_csv(\"dataset/phishing_features.csv\")\n",
    "df = pd.concat([df0, df1, df2], axis=0, ignore_index=True)\n",
    "#gives us the size of the table\n",
    "print(df.shape)\n",
    "#tells us what data types are in each column\n",
    "print(df.dtypes)\n",
    "#counts the missing values if there are any\n",
    "print(df.isna().sum())\n",
    "#counts the amount of each value appear in the data\n",
    "print(df[\"type\"].value_counts())\n",
    "#shows 10 random rows as an example\n",
    "df.sample(10)"
   ]
